From b5c5b10f3a0909b4a3071eedf1f64ef636f8904a Mon Sep 17 00:00:00 2001
From: cl0nazepamm <46329307+cl0nazepamm@users.noreply.github.com>
Date: Wed, 14 Oct 2026 05:21:28 +0300
Subject: [PATCH 01/73] ntdll: Honor <probing privatePath> from the application
 .config file.

Native Windows reads <exe>.config next to the main executable and adds
the semicolon-separated <configuration><windows><assemblyBinding>
<probing privatePath="..."/> directories to the private assembly search
path. Autodesk's ODIS Setup.exe ships Setup.exe.config with
privatePath="ODIS" and fails to resolve its side-by-side assemblies
without it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/ntdll/actctx.c | 156 +++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 155 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/actctx.c b/dlls/ntdll/actctx.c
index bc80065..da78a0d 100644
--- a/dlls/ntdll/actctx.c
+++ b/dlls/ntdll/actctx.c
@@ -590,6 +590,7 @@ struct actctx_loader
     struct assembly_identity *dependencies;
     unsigned int              num_dependencies;
     unsigned int              allocated_dependencies;
+    WCHAR                    *private_path;
 };
 
 static const xmlstr_t empty_xmlstr;
@@ -1005,6 +1006,7 @@ static void free_depend_manifests(struct actctx_loader* acl)
     for (i = 0; i < acl->num_dependencies; i++)
         free_assembly_identity(&acl->dependencies[i]);
     RtlFreeHeap(GetProcessHeap(), 0, acl->dependencies);
+    RtlFreeHeap(GetProcessHeap(), 0, acl->private_path);
 }
 
 static WCHAR *build_assembly_dir(struct assembly_identity* ai)
@@ -3369,11 +3371,98 @@ done:
     return status;
 }
 
+static void parse_probing_elem( xmlbuf_t *xmlbuf, const struct xml_elem *parent, xmlstr_t *private_path )
+{
+    struct xml_attr attr;
+    BOOL end = FALSE;
+
+    while (next_xml_attr(xmlbuf, &attr, &end))
+    {
+        if (xml_attr_cmp(&attr, L"privatePath")) *private_path = attr.value;
+        else if (!is_xmlns_attr( &attr )) WARN("unknown attr %s\n", debugstr_xml_attr(&attr));
+    }
+
+    if (!end) parse_expect_end_elem(xmlbuf, parent);
+}
+
+/* walk <configuration><windows><assemblyBinding><probing> */
+static void parse_app_config_elem( xmlbuf_t *xmlbuf, const struct xml_elem *parent,
+                                   unsigned int depth, xmlstr_t *private_path )
+{
+    static const WCHAR * const names[] = { L"windows", L"assemblyBinding", L"probing" };
+    struct xml_elem elem;
+    struct xml_attr attr;
+    BOOL end = FALSE;
+
+    while (next_xml_attr(xmlbuf, &attr, &end));
+    if (end) return;
+
+    while (next_xml_elem(xmlbuf, &elem, parent))
+    {
+        if (!xmlstr_cmp(&elem.name, names[depth])) parse_unknown_elem(xmlbuf, &elem);
+        else if (depth == ARRAY_SIZE(names) - 1) parse_probing_elem(xmlbuf, &elem, private_path);
+        else parse_app_config_elem(xmlbuf, &elem, depth + 1, private_path);
+    }
+}
+
+/* read the privatePath probing directories from an application configuration file */
+static WCHAR *get_app_config_private_path( const WCHAR *config )
+{
+    FILE_END_OF_FILE_INFORMATION info;
+    IO_STATUS_BLOCK io;
+    UNICODE_STRING nameW;
+    struct xml_elem elem, parent = {};
+    xmlstr_t private_path = {};
+    xmlbuf_t xmlbuf = {};
+    WCHAR *buffer = NULL, *ret = NULL;
+    char *data = NULL;
+    NTSTATUS status;
+    HANDLE file;
+    DWORD len;
+
+    if (!RtlDosPathNameToNtPathName_U( config, &nameW, NULL, NULL )) return NULL;
+    status = open_nt_file( &file, &nameW );
+    RtlFreeUnicodeString( &nameW );
+    if (status) return NULL;
+
+    status = NtQueryInformationFile( file, &io, &info, sizeof(info), FileEndOfFileInformation );
+    if (status || !info.EndOfFile.QuadPart || info.EndOfFile.QuadPart > 0x100000) goto done;
+    if (!(data = RtlAllocateHeap( GetProcessHeap(), 0, info.EndOfFile.QuadPart ))) goto done;
+    if (NtReadFile( file, NULL, NULL, NULL, &io, data, info.EndOfFile.QuadPart, NULL, NULL )) goto done;
+
+    /* let's assume utf-8 for now */
+    RtlUTF8ToUnicodeN( NULL, 0, &len, data, io.Information );
+    if (!(buffer = RtlAllocateHeap( GetProcessHeap(), 0, len ))) goto done;
+    RtlUTF8ToUnicodeN( buffer, len, &len, data, io.Information );
+    xmlbuf.ptr = buffer;
+    xmlbuf.end = buffer + len / sizeof(WCHAR);
+
+    if (!next_xml_elem( &xmlbuf, &elem, &parent )) goto done;
+    if (xmlstr_cmp( &elem.name, L"?xml" ) &&
+        (!parse_xml_header( &xmlbuf ) || !next_xml_elem( &xmlbuf, &elem, &parent )))
+        goto done;
+    if (!xmlstr_cmp( &elem.name, L"configuration" )) goto done;
+
+    parse_app_config_elem( &xmlbuf, &elem, 0, &private_path );
+    if (private_path.len && (ret = RtlAllocateHeap( GetProcessHeap(), 0, (private_path.len + 1) * sizeof(WCHAR) )))
+    {
+        memcpy( ret, private_path.ptr, private_path.len * sizeof(WCHAR) );
+        ret[private_path.len] = 0;
+        TRACE( "%s privatePath %s\n", debugstr_w(config), debugstr_w(ret) );
+    }
+
+done:
+    RtlFreeHeap( GetProcessHeap(), 0, buffer );
+    RtlFreeHeap( GetProcessHeap(), 0, data );
+    NtClose( file );
+    return ret;
+}
+
 static NTSTATUS lookup_assembly(struct actctx_loader* acl,
                                 struct assembly_identity* ai)
 {
     WCHAR *buffer, *p, *directory;
-    const WCHAR *lang = ai->language;
+    const WCHAR *lang = ai->language, *path, *next;
     NTSTATUS status;
     DWORD len, total;
 
@@ -3387,6 +3476,7 @@ static NTSTATUS lookup_assembly(struct actctx_loader* acl,
 
     len = max(RtlGetFullPathName_U(acl->actctx->assemblies->manifest.info, 0, NULL, NULL) / sizeof(WCHAR),
         wcslen(acl->actctx->appdir.info));
+    if (acl->private_path) len += wcslen(acl->private_path) + 1;
     total = len + 2 * wcslen(ai->name) + wcslen(lang) + 12;
 
     if (!(buffer = RtlAllocateHeap( GetProcessHeap(), 0, total * sizeof(WCHAR) ))) return STATUS_NO_MEMORY;
@@ -3415,6 +3505,28 @@ static NTSTATUS lookup_assembly(struct actctx_loader* acl,
     status = open_manifest_file( acl, ai, lang, directory, buffer, total );
     if (status != STATUS_SXS_ASSEMBLY_NOT_FOUND) goto done;
 
+    /* then the privatePath directories from the application configuration file,
+     * as <appdir>\<path>\ and <appdir>\<path>\name\ */
+    for (path = acl->private_path; path && *path; path = next)
+    {
+        if (!(next = wcschr( path, ';' ))) next = path + wcslen( path );
+        if (next != path)
+        {
+            p = buffer + swprintf( buffer, total, L"%s", acl->actctx->appdir.info );
+            memcpy( p, path, (next - path) * sizeof(WCHAR) );
+            p += next - path;
+            *p++ = '\\';
+            *p = 0;
+            status = open_manifest_file( acl, ai, lang, directory, buffer, total );
+            if (status != STATUS_SXS_ASSEMBLY_NOT_FOUND) goto done;
+
+            swprintf( p, total - (p - buffer), L"%s\\", ai->name );
+            status = open_manifest_file( acl, ai, lang, directory, buffer, total );
+            if (status != STATUS_SXS_ASSEMBLY_NOT_FOUND) goto done;
+        }
+        if (*next) next++;
+    }
+
     if (RtlGetFullPathName_U( acl->actctx->assemblies->manifest.info, len * sizeof(WCHAR), buffer, &p ))
     {
         *p = 0;
@@ -5281,6 +5393,43 @@ void actctx_init(void)
 }
 
 
+/* an executable's <name>.config file can extend the private assembly search path */
+static void init_app_config( struct actctx_loader *acl, const ACTCTXW *pActCtx )
+{
+    ACTIVATION_CONTEXT *actctx = acl->actctx;
+    UNICODE_STRING module;
+    const WCHAR *ext;
+    WCHAR *config;
+    SIZE_T len;
+
+    if (pActCtx->dwFlags & ACTCTX_FLAG_HMODULE_VALID)
+    {
+        if (get_module_filename( pActCtx->hModule, &module, sizeof(L".config") )) return;
+        config = module.Buffer;
+    }
+    else
+    {
+        if (!pActCtx->lpSource) return;
+        len = wcslen( pActCtx->lpSource );
+        if (!(config = RtlAllocateHeap( GetProcessHeap(), 0, len * sizeof(WCHAR) + sizeof(L".config") ))) return;
+        wcscpy( config, pActCtx->lpSource );
+    }
+
+    if (!(ext = wcsrchr( config, '.' )) || wcsicmp( ext, L".exe" ))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, config );
+        return;
+    }
+    wcscat( config, L".config" );
+
+    if ((acl->private_path = get_app_config_private_path( config )))
+    {
+        actctx->config.type = ACTIVATION_CONTEXT_PATH_TYPE_WIN32_FILE;
+        actctx->config.info = config;
+    }
+    else RtlFreeHeap( GetProcessHeap(), 0, config );
+}
+
 /***********************************************************************
  * RtlCreateActivationContext (NTDLL.@)
  *
@@ -5388,6 +5537,11 @@ NTSTATUS WINAPI RtlCreateActivationContext( ACTIVATION_CONTEXT **new_actctx, con
     acl.dependencies = NULL;
     acl.num_dependencies = 0;
     acl.allocated_dependencies = 0;
+    acl.private_path = NULL;
+
+    if (!(pActCtx->dwFlags & ACTCTX_FLAG_HMODULE_VALID) ||
+        pActCtx->hModule == NtCurrentTeb()->Peb->ImageBaseAddress)
+        init_app_config( &acl, pActCtx );
 
     if (pActCtx->dwFlags & ACTCTX_FLAG_LANGID_VALID) lang = pActCtx->wLangId;
     if (pActCtx->dwFlags & ACTCTX_FLAG_ASSEMBLY_DIRECTORY_VALID) directory = pActCtx->lpAssemblyDirectory;
-- 
