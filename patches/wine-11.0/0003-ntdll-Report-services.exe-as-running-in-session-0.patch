From 8e16c03f92bb6172e467455d662513617dcd09f7 Mon Sep 17 00:00:00 2001
From: cl0nazepamm <46329307+cl0nazepamm@users.noreply.github.com>
Date: Wed, 14 Oct 2026 05:21:28 +0300
Subject: [PATCH 03/73] ntdll: Report services.exe as running in session 0.

Go's golang.org/x/sys/windows/svc.IsWindowsService() and .NET's
WindowsServiceHelpers.IsWindowsService() decide whether they were started
by the SCM by checking that the parent process is services.exe *and* that
it runs in session 0, as on Windows. Wine places every process in session
1, so such services run in console mode, never call
StartServiceCtrlDispatcher, and the SCM fails the start with
ERROR_SERVICE_REQUEST_TIMEOUT (1053). Autodesk's AdskLicensingService
(Go 1.25) is affected.

Only the session id reported through SystemProcessInformation changes;
services keep their session 1 object namespace and window station.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/ntdll/unix/system.c | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/unix/system.c b/dlls/ntdll/unix/system.c
index 350bcea..d7d6141 100644
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -3024,6 +3024,22 @@ static void read_dev_urandom( void *buf, ULONG len )
     else WARN( "can't open /dev/urandom\n" );
 }
 
+/* Go's svc.IsWindowsService() and .NET's WindowsServiceHelpers.IsWindowsService() treat a process
+ * as a service only if its parent is services.exe running in session 0, as on Windows. Wine runs
+ * everything in session 1, so report the service control manager as living in session 0. */
+static BOOL is_service_control_manager( const WCHAR *name, ULONG len )
+{
+    static const WCHAR services_exe[] = {'\\','s','y','s','t','e','m','3','2','\\',
+                                         's','e','r','v','i','c','e','s','.','e','x','e'};
+    ULONG i, n = ARRAY_SIZE(services_exe);
+
+    if (len < n) return FALSE;
+    name += len - n;
+    for (i = 0; i < n; i++)
+        if (ntdll_towupper( name[i] ) != ntdll_towupper( services_exe[i] )) return FALSE;
+    return TRUE;
+}
+
 static unsigned int get_system_process_info( SYSTEM_INFORMATION_CLASS class, void *info, ULONG size, ULONG *len )
 {
     unsigned int process_count, total_thread_count, total_name_len, i, j;
@@ -3100,7 +3116,8 @@ C_ASSERT( sizeof(struct process_info) <= sizeof(SYSTEM_PROCESS_INFORMATION) );
             nt_process->dwBasePriority = server_process->priority;
             nt_process->UniqueProcessId = UlongToHandle(server_process->pid);
             nt_process->ParentProcessId = UlongToHandle(server_process->parent_pid);
-            nt_process->SessionId = server_process->session_id;
+            nt_process->SessionId = is_service_control_manager( server_name, server_process->name_len / sizeof(WCHAR) )
+                                    ? 0 : server_process->session_id;
             nt_process->HandleCount = server_process->handle_count;
             get_thread_times( server_process->unix_pid, -1, &nt_process->KernelTime, &nt_process->UserTime );
             fill_vm_counters( &nt_process->vmCounters, server_process->unix_pid );
-- 
