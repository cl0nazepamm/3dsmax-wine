+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdlib.h>
+#include <pthread.h>
+
+#include "macdrv.h"
+#include "wine/list.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(macdrv);
+
+/* DXMT's winemetal.so looks up "macdrv_functions" with dlsym() and expects get_win_data() to
+ * return a struct that starts with these four fields (the CrossOver layout). Wine 11 keeps no
+ * client view per window anymore, so each caller gets its own client surface, as the Vulkan
+ * driver does, and it lives until the metal view created on it is released. */
+struct dxmt_win_data
+{
+    HWND          hwnd;
+    macdrv_window cocoa_window;
+    macdrv_view   cocoa_view;
+    macdrv_view   client_cocoa_view;
+    struct macdrv_client_surface *surface;
+};
+
+struct dxmt_view
+{
+    struct list entry;
+    struct macdrv_client_surface *surface;
+    macdrv_metal_view metal_view;
+};
+
+static struct list dxmt_views = LIST_INIT(dxmt_views);
+static pthread_mutex_t dxmt_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static struct dxmt_win_data *dxmt_get_win_data(HWND hwnd)
+{
+    struct dxmt_win_data *data;
+    struct dxmt_view *view;
+
+    if (!(data = calloc(1, sizeof(*data)))) return NULL;
+    data->hwnd = hwnd;
+    if (!(data->surface = macdrv_client_surface_create(hwnd))) return data;
+    data->client_cocoa_view = data->surface->cocoa_view;
+
+    if ((view = calloc(1, sizeof(*view))))
+    {
+        view->surface = data->surface;
+        pthread_mutex_lock(&dxmt_mutex);
+        list_add_tail(&dxmt_views, &view->entry);
+        pthread_mutex_unlock(&dxmt_mutex);
+    }
+
+    TRACE("hwnd %p surface %p view %p\n", hwnd, data->surface, data->client_cocoa_view);
+    return data;
+}
+
+static void dxmt_release_win_data(struct dxmt_win_data *data)
+{
+    struct dxmt_view *view;
+    BOOL unused = FALSE;
+
+    if (!data) return;
+    if (data->surface)
+    {
+        /* no metal view was made on the surface: nothing else will release it */
+        pthread_mutex_lock(&dxmt_mutex);
+        LIST_FOR_EACH_ENTRY(view, &dxmt_views, struct dxmt_view, entry)
+        {
+            if (view->surface != data->surface || view->metal_view) continue;
+            list_remove(&view->entry);
+            free(view);
+            unused = TRUE;
+            break;
+        }
+        pthread_mutex_unlock(&dxmt_mutex);
+        if (unused) client_surface_release(&data->surface->client);
+    }
+    free(data);
+}
+
+static macdrv_metal_view dxmt_view_create_metal_view(macdrv_view cocoa_view, macdrv_metal_device device)
+{
+    macdrv_metal_view metal_view;
+    struct dxmt_view *view;
+
+    if (!cocoa_view || !(metal_view = macdrv_view_create_metal_view(cocoa_view, device))) return NULL;
+
+    pthread_mutex_lock(&dxmt_mutex);
+    LIST_FOR_EACH_ENTRY(view, &dxmt_views, struct dxmt_view, entry)
+    {
+        if (view->surface->cocoa_view != cocoa_view || view->metal_view) continue;
+        view->metal_view = metal_view;
+        break;
+    }
+    pthread_mutex_unlock(&dxmt_mutex);
+
+    TRACE("view %p metal view %p\n", cocoa_view, metal_view);
+    return metal_view;
+}
+
+static void dxmt_view_release_metal_view(macdrv_metal_view metal_view)
+{
+    struct macdrv_client_surface *surface = NULL;
+    struct dxmt_view *view;
+
+    TRACE("metal view %p\n", metal_view);
+
+    macdrv_view_release_metal_view(metal_view);
+
+    pthread_mutex_lock(&dxmt_mutex);
+    LIST_FOR_EACH_ENTRY(view, &dxmt_views, struct dxmt_view, entry)
+    {
+        if (view->metal_view != metal_view) continue;
+        surface = view->surface;
+        list_remove(&view->entry);
+        free(view);
+        break;
+    }
+    pthread_mutex_unlock(&dxmt_mutex);
+
+    if (surface) client_surface_release(&surface->client);
+}
+
+struct macdrv_functions_t
+{
+    void (*macdrv_init_display_devices)(BOOL);
+    struct dxmt_win_data *(*get_win_data)(HWND hwnd);
+    void (*release_win_data)(struct dxmt_win_data *data);
+    macdrv_window (*macdrv_get_cocoa_window)(HWND hwnd, BOOL require_on_screen);
+    macdrv_metal_device (*macdrv_create_metal_device)(void);
+    void (*macdrv_release_metal_device)(macdrv_metal_device d);
+    macdrv_metal_view (*macdrv_view_create_metal_view)(macdrv_view v, macdrv_metal_device d);
+    macdrv_metal_layer (*macdrv_view_get_metal_layer)(macdrv_metal_view v);
+    void (*macdrv_view_release_metal_view)(macdrv_metal_view v);
+    void (*on_main_thread)(void *block);  /* dispatch_block_t; not provided */
+};
+
+DECLSPEC_EXPORT struct macdrv_functions_t macdrv_functions =
+{
+    .get_win_data = dxmt_get_win_data,
+    .release_win_data = dxmt_release_win_data,
+    .macdrv_get_cocoa_window = macdrv_get_cocoa_window,
+    .macdrv_create_metal_device = macdrv_create_metal_device,
+    .macdrv_release_metal_device = macdrv_release_metal_device,
+    .macdrv_view_create_metal_view = dxmt_view_create_metal_view,
+    .macdrv_view_get_metal_layer = macdrv_view_get_metal_layer,
+    .macdrv_view_release_metal_view = dxmt_view_release_metal_view,
+};
-- 
