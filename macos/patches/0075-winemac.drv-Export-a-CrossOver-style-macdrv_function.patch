From 9eea750c370a5f354f15b1a24d4230e5a1b07e9c Mon Sep 17 00:00:00 2001
From: 3dsmax-wine <3dsmax-wine@localhost>
Date: Mon, 19 Oct 2026 16:18:43 +0300
Subject: [PATCH] winemac.drv: Export a CrossOver-style macdrv_functions table
 for DXMT.

DXMT's winemetal.so looks up macdrv_functions with dlsym() and expects get_win_data()
to return the CrossOver win_data layout. Wine 11 has no per-window client view, so
give each caller its own client surface, like the Vulkan driver does.
---
 dlls/winemac.drv/Makefile.in |   1 +
 dlls/winemac.drv/dxmt.c      | 170 +++++++++++++++++++++++++++++++++++
 2 files changed, 171 insertions(+)
 create mode 100644 dlls/winemac.drv/dxmt.c

diff --git a/dlls/winemac.drv/Makefile.in b/dlls/winemac.drv/Makefile.in
index 621388f..9b025ad 100644
--- a/dlls/winemac.drv/Makefile.in
+++ b/dlls/winemac.drv/Makefile.in
@@ -27,6 +27,7 @@ SOURCES = \
 	cocoa_window.m \
 	display.c \
 	dllmain.c \
+	dxmt.c \
 	event.c \
 	gdi.c \
 	image.c \
diff --git a/dlls/winemac.drv/dxmt.c b/dlls/winemac.drv/dxmt.c
new file mode 100644
index 0000000..7b5aa72
--- /dev/null
+++ b/dlls/winemac.drv/dxmt.c
@@ -0,0 +1,170 @@
+/*
+ * Metal view exports for DXMT
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
